NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
PUBLIC_URL=
NEXT_PUBLIC_VERSION=
BASE_NAME=
NEXT_PUBLIC_GOOGLE_ID=
EMAIL_BUSINESS=
EMAIL_PASS=
NEXT_PUBLIC_CALENDLY_URL=

# Lead form -> Notion CRM (required for leads to be saved to Notion).
# NOTION_API_KEY: internal integration secret from notion.so/my-integrations.
#   The integration must be shared with the leads database (Connections menu).
# NOTION_LEADS_DATABASE_ID: optional override of the target database id.
# NOTION_LEAD_FOLLOWUP_DAYS: optional, days out for a new lead's Follow-up Date (default 1).
NOTION_API_KEY=
NOTION_LEADS_DATABASE_ID=
NOTION_LEAD_FOLLOWUP_DAYS=

# Etsy semi-custom listing shown to under-$800 budgets (optional override).
NEXT_PUBLIC_ETSY_SEMI_CUSTOM_URL=

# Branding intake questionnaire (/intake/[client]). Submissions are emailed via
# the same nodemailer transport as the lead form (EMAIL_BUSINESS / EMAIL_PASS).
# INTAKE_TO_EMAIL: optional override of who receives them; defaults to EMAIL_BUSINESS.
INTAKE_TO_EMAIL=
